<Window x:Class="Apollo.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PS4 Apollo Auto Backup"
        Width="700" Height="550" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Window.Resources>
    <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="CompactCount" TargetType="TextBlock" BasedOn="{StaticResource Count}"><Setter Property="FontSize" Value="24"/></Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Right" Text="v1.1.0" Foreground="#526175" VerticalAlignment="Center"/>
      <TextBlock Text="PS4 Apollo Auto Backup" FontSize="22" FontWeight="SemiBold"/>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource CompactCard}">
      <StackPanel>
        <DockPanel><TextBlock x:Name="StatusHeading" Text="Monitoring" FontSize="19" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="ConnectionLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#526175" FontSize="12"/></DockPanel>
        <TextBlock x:Name="StatusDetail" Text="Getting ready…" Margin="0,3,0,9" TextWrapping="Wrap"/>
        <ProgressBar x:Name="BusyBar" Height="3" Margin="0,0,0,7" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Checking saves"/>
        <WrapPanel><Button x:Name="BackupButton" Content="_Check saves now" Click="Backup_Click" IsEnabled="False" ToolTip="Check available saves and back up anything new or changed"/>
          <Button Content="Open backup _folder" Click="Folder_Click"/></WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource CompactCard}">
      <StackPanel>
        <DockPanel><TextBlock Text="Last backup" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="LastTime" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#526175" FontSize="12"/></DockPanel>
        <TextBlock x:Name="LastOutcome" Text="No completed backup yet" Margin="0,3,0,5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <UniformGrid Columns="5">
          <StackPanel><TextBlock x:Name="TotalCount" Text="—" Style="{StaticResource CompactCount}"/><TextBlock Text="saves checked" Foreground="#526175" FontSize="12"/></StackPanel>
          <StackPanel><TextBlock x:Name="NewCount" Text="—" Style="{StaticResource CompactCount}"/><TextBlock Text="new" Foreground="#526175" FontSize="12"/></StackPanel>
          <StackPanel><TextBlock x:Name="ChangedCount" Text="—" Style="{StaticResource CompactCount}"/><TextBlock Text="changed" Foreground="#526175" FontSize="12"/></StackPanel>
          <StackPanel><TextBlock x:Name="UnchangedCount" Text="—" Style="{StaticResource CompactCount}"/><TextBlock Text="unchanged" Foreground="#526175" FontSize="12"/></StackPanel>
          <StackPanel><TextBlock x:Name="FailureCount" Text="—" Style="{StaticResource CompactCount}"/><TextBlock Text="failures" Foreground="#526175" FontSize="12"/></StackPanel>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource CompactCard}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,5"><Button DockPanel.Dock="Right" Content="View _history" Click="Diagnostics_Click" Padding="6,0" MinHeight="24" FontSize="12" Margin="0"/>
          <TextBlock Text="Recent activity" FontSize="16" FontWeight="SemiBold"/></DockPanel>
        <ScrollViewer x:Name="ActivityScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid><ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" VerticalAlignment="Center" Foreground="#526175" FontSize="12" ToolTip="{Binding Timestamp}"/>
              <Border Grid.Column="1" Background="{Binding Background}" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontWeight="SemiBold" FontSize="12"/>
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock x:Name="EmptyActivity" Text="Your completed checks will appear here." Foreground="#526175" TextWrapping="Wrap"/></Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <DockPanel Grid.Row="4">
      <WrapPanel><Button Content="_Settings" Click="Settings_Click"/><Button Content="_Diagnostics" Click="Diagnostics_Click"/><Button Content="E_xit" Click="Exit_Click"/></WrapPanel>
      <TextBlock Text="Closing keeps monitoring on." HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#526175" FontSize="12" TextWrapping="Wrap" ToolTip="Closing this window keeps the app in the notification area. Choose Exit to stop completely."/>
    </DockPanel>
  </Grid>
</Window>
